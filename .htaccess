# ================================================================
# USA Insulation of North & SW Houston
# Apache / LiteSpeed — cPanel deployment
# Flat URL structure — all pages at root level
# ================================================================

Options -Indexes -MultiViews +FollowSymLinks
DirectoryIndex index.html
ErrorDocument 404 /404.html

# ----------------------------------------------------------------
# HTTPS enforcement (uncomment once SSL cert is active on cPanel)
# ----------------------------------------------------------------
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} off
#   RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
# </IfModule>

# ----------------------------------------------------------------
# WWW → non-www canonical (uncomment if you prefer non-www)
# ----------------------------------------------------------------
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
#   RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
# </IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ── 1. Strip index.html ─────────────────────────────────────────
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^ / [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+(.+/)?index\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # ── 2. Strip .html extension ────────────────────────────────────
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # ── 3. Old /services/* → flat root URLs (301) ───────────────────
  RewriteRule ^services/spray-foam-insulation/?$    /spray-foam-insulation    [R=301,L]
  RewriteRule ^services/injection-foam-insulation/? /injection-foam-insulation [R=301,L]
  RewriteRule ^services/attic-insulation/?$         /attic-insulation          [R=301,L]
  RewriteRule ^services/air-sealing/?$              /air-sealing               [R=301,L]
  RewriteRule ^services/attic-fan-ventilation/?$    /attic-fan-ventilation     [R=301,L]
  RewriteRule ^services/?$                          /contact                   [R=301,L]

  # ── 4. Old /service-areas/* → flat root URLs (301) ──────────────
  RewriteRule ^service-areas/conroe/?$   /insulation-conroe  [R=301,L]
  RewriteRule ^service-areas/cypress/?$  /insulation-cypress [R=301,L]
  RewriteRule ^service-areas/tomball/?$  /insulation-tomball [R=301,L]
  RewriteRule ^service-areas/?$          /contact            [R=301,L]

  # ── 5. Internal rewrites: clean slug → .html file ───────────────
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([^/]+)$ $1.html [L]

</IfModule>

# ----------------------------------------------------------------
# Gzip / Brotli compression
# ----------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css \
    application/javascript application/json image/svg+xml \
    application/xml application/xhtml+xml application/rss+xml
</IfModule>

# ----------------------------------------------------------------
# Browser caching
# ----------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html              "access plus 1 hour"
  ExpiresByType text/css               "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/svg+xml          "access plus 6 months"
  ExpiresByType image/png              "access plus 6 months"
  ExpiresByType image/jpeg             "access plus 6 months"
  ExpiresByType image/webp             "access plus 6 months"
  ExpiresByType image/gif              "access plus 6 months"
  ExpiresByType font/woff2             "access plus 1 year"
</IfModule>

# ----------------------------------------------------------------
# Security headers
# ----------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header unset Server
  Header unset X-Powered-By
</IfModule>

# ----------------------------------------------------------------
# Protect sensitive files
# ----------------------------------------------------------------
<FilesMatch "\.(htaccess|htpasswd|env|log|ini|json|toml|md)$">
  Require all denied
</FilesMatch>
